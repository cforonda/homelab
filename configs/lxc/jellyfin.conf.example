# Sanitized example. Export the live config with: pct config JELLYFIN_CTID
arch: amd64
cores: 2
dev0: /dev/dri/renderD128,gid=RENDER_GID,mode=0660
features: nesting=1
hostname: jellyfin
memory: 4096
mp0: /data/jellyfin,mp=/mnt/jellyfin,ro=1
net0: name=eth0,bridge=BRIDGE_NAME,firewall=1,gw=GATEWAY_IP,ip=JELLYFIN_IP/LAN_PREFIX,ip6=manual,type=veth
onboot: 1
ostype: debian
rootfs: local-lvm:vm-JELLYFIN_CTID-disk-0,size=16G
startup: order=2,up=20,down=30
swap: 512
unprivileged: 1

